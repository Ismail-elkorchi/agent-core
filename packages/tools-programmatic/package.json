{
  "name": "@agent-core/tools-programmatic",
  "version": "0.2.0",
  "description": "Optional isolated programmatic tool orchestration for Agent Core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.8.0"
  },
  "dependencies": {
    "@agent-core/json": "0.2.0",
    "@agent-core/runtime": "0.2.0",
    "@agent-core/tools": "0.2.0",
    "quickjs-emscripten": "0.32.0",
    "zod": "^4.4.3",
    "acorn": "8.15.0"
  }
}
